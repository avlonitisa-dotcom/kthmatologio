# ══════════════════════════════════════════════════════════════
# TEE KAEK Automation — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════

# ── TEE Credentials (required) ─────────────────────────────────
TEE_USERNAME=jemvolpidis
TEE_PASSWORD=lev0305

# ── Portal URLs (update after inspecting the live portal) ──────
TEE_SSO_URL=https://sso.tee.gr/auth/realms/tee/protocol/openid-connect/auth
KTIMATOLOGIO_PORTAL_URL=https://www.ktimatologio.gr/
MAP_BASE_URL=https://maps.ktimatologio.gr/

# ── Automation Pacing ───────────────────────────────────────────
# Human-like delays between actions (seconds)
MIN_DELAY=2.0
MAX_DELAY=5.0
PAGE_LOAD_TIMEOUT=30000
ELEMENT_TIMEOUT=15000

# ── Browser ────────────────────────────────────────────────────
# Set HEADLESS=true to hide the browser window
HEADLESS=false
BROWSER_TYPE=chromium

# ── Retry ──────────────────────────────────────────────────────
MAX_RETRIES=2

# ── Server ─────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8080

# ── Optional: LLM Classification ───────────────────────────────
# Set to enable Claude-based Greek legal text classification
# ANTHROPIC_API_KEY=sk-ant-...
